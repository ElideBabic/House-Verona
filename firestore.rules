rules_version = '2';

// Zalijepi ovo u Firebase konzoli: Firestore Database → Rules → Publish.
// Zamijeni ADMIN_UID stvarnim UID-om svog Google računa (isti kao u firebase-config.js).

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && request.auth.uid == '9lS4aRecbLdOMX5Npn27KuCYfLH3';
    }

    function validWeeks() {
      return request.resource.data.keys().hasOnly(['booked', 'updatedAt', 'updatedBy'])
        && request.resource.data.booked is list
        && request.resource.data.booked.size() <= 520
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time;
    }

    // Kalendar je javno čitljiv, mijenjati ga smije samo vlasnički račun.
    match /availability/weeks {
      allow read: if true;
      allow create, update: if isAdmin() && validWeeks();
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
